# Which provider the adapter uses. One of: dexscreener | pumpfun | birdeye
# Default (and zero-config, no key required): dexscreener
MARKET_PROVIDER=dexscreener

# Cache TTL in milliseconds for trending / token lookups (default 30000)
MARKET_CACHE_TTL_MS=30000

# Required ONLY when MARKET_PROVIDER=birdeye. Never commit a real key.
BIRDEYE_API_KEY=
